# ─── Development image ────────────────────────────────────────────────────────
# Runs Vite dev server with HMR on port 5173.
# Source is bind-mounted from host so edits reflect instantly.

FROM node:22-alpine

WORKDIR /app

# Install deps first (cached layer)
COPY package.json package-lock.json* ./
RUN npm install

# Copy source (only used if not bind-mounting)
COPY . .

EXPOSE 5173

CMD ["npm", "run", "dev"]